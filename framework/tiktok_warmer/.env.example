# Copiar a .env y completar con el endpoint real. No sobrescribir un .env privado existente.
PROXY_PROVIDER=proxy_cheap
PROXY_MODE=rotating_residential
PROXY_HOST=thehub.proxy-cheap.com
PROXY_PORT=8080
PROXY_PROTOCOL=socks5
PROXY_USER=
PROXY_PASS=
# También se aceptan PROXY_URL, PROXY_USERNAME y PROXY_PASSWORD del laboratorio anterior.
# Solo PROXY_MODE=mobile_api: link secreto de rotación GET. No aplica al residencial aleatorio.
PROXY_ROTATION_URL=
PROXY_ROTATION_WAIT_SECONDS=10
# Solo para un módem local que no soporte HTTPS, con IP privada/localhost explícitos:
PROXY_ROTATION_ALLOW_LOCAL_HTTP=0
# OpenAI no se utiliza en esta prueba; se conserva la clave del proyecto principal.
